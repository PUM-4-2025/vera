{
  "name": "vera",
  "private": true,
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0"
  },
  "lint-staged": {
    "client/**/*.{js,jsx,ts,tsx}": [
      "npx prettier --write --config client/.prettierrc.json",
      "npx eslint --fix --config client/eslint.config.js"
    ],
    "client/**/*.{json,css,md}": [
      "npx prettier --write --config client/.prettierrc.json"
    ]
  }
}

